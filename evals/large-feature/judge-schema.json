{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": ["candidates"],
  "properties": {
    "candidates": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "completeness",
          "coherence",
          "scope_discipline",
          "single_path",
          "critical_failure",
          "evidence"
        ],
        "properties": {
          "id": { "type": "string" },
          "completeness": { "type": "integer", "minimum": 0, "maximum": 3 },
          "coherence": { "type": "integer", "minimum": 0, "maximum": 3 },
          "scope_discipline": { "type": "integer", "minimum": 0, "maximum": 3 },
          "single_path": { "type": "integer", "minimum": 0, "maximum": 3 },
          "critical_failure": { "type": "boolean" },
          "evidence": { "type": "string" }
        }
      }
    }
  }
}
